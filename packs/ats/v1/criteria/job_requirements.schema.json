{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job requirements",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "title": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "seniority": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "importance": {
            "type": "string",
            "enum": [
              "mandatory",
              "important",
              "nice_to_have"
            ]
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_years": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
