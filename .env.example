# Local docker compose secrets. Copy to .env (never commit .env) - or run ./scripts/local_env.sh, which copies this
# file and replaces every __GENERATE__ with a fresh random value (EC P-256 PEM for the signing key, random hex for
# the rest) without printing anything. Values here are placeholders only.

# Postgres superuser (also inside DATABASE_URL of every service)
POSTGRES_USER=ats
POSTGRES_PASSWORD=__GENERATE__

# The one platform Redis
REDIS_PASSWORD=__GENERATE__

# FalkorDB (knowledge graph store)
FALKORDB_PASSWORD=__GENERATE__

# LLM gateway master key = the key the services send
LLM_GATEWAY_KEY=__GENERATE__

# auth-service signing key: PEM of an EC P-256 private key on ONE line, newlines written as \n
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | tr -d '\r' | awk '{printf "%s\\n", $0}'
AUTH_SIGNING_KEY=__GENERATE__

# client_credentials secrets of the calling services (read by the caller and by the auth-service)
CLIENT_SECRET_ATS_ORCHESTRATOR=__GENERATE__
CLIENT_SECRET_AGENT_KNOWLEDGE_GRAPH=__GENERATE__
CLIENT_SECRET_AGENT_DOCUMENT=__GENERATE__
CLIENT_SECRET_AGENT_SKILL=__GENERATE__
CLIENT_SECRET_REGISTRY_SERVICE=__GENERATE__

# Optional: where the model backends run (defaults: LM Studio on the host, vLLM on the LAN)
# LMSTUDIO_API_BASE=http://host.docker.internal:1235/v1
# VLLM_QWEN3_4B_API_BASE=http://192.168.0.120:8001/v1
