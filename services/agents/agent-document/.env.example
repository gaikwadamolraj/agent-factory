# agent-document - copy to .env for local runs (never commit .env). Secrets come from the k8s Secret in clusters.
APP_ENV=DEV
AUTH_ISSUER=http://auth-service                                  # tokens: auth-service ES256, verified with its JWKS
AUTH_JWKS_URL=http://localhost:8004/.well-known/jwks.json
AUTH_TOKEN_URL=http://localhost:8004/oauth/token

# Zero trust: callers allowed to reach this agent, and which tools each may use.
ALLOWED_CALLERS=ats-orchestrator
TOOL_POLICY=ats-orchestrator=read_document|scan_document|chunk_document

# This service's client_credentials secret (only needed when GUARDRAIL_MCP_URL is set, i.e. it calls agent-guardrail).
SERVICE_CLIENT_SECRET=

# Injection scanning via the shared guardrails service. Empty = local pattern checks only (no service call).
GUARDRAIL_MCP_URL=http://agent-guardrail/mcp
GUARDRAIL_TIMEOUT_S=20

# LLM gateway (only used by chunk_document when embedding; embedding is optional/non-fatal).
LLM_GATEWAY_URL=http://ats-llm-gateway/v1
LLM_GATEWAY_KEY=

# Extraction tiers. "auto" probes each PDF cheaply and picks one:
#   fast    - pypdfium2, text only, for ordinary digital PDFs
#   tables  - pdfplumber, for digital PDFs whose pages carry real ruled tables
#   docling - layout ML with optional OCR, for scanned/image-heavy pages; needs the optional `docling` extra
#             (pip install "docling>=2.149.0", or build the image with --build-arg WITH_DOCLING=1). Without the
#             extra installed the router falls back to the lighter tiers, so this stays safe to leave on "auto".
DOCUMENT_EXTRACTOR=auto
DOCLING_ARTIFACTS_PATH=                                          # pre-downloaded Docling models; empty = library cache
DOCLING_OCR=false                                                # OCR scanned pages when the docling tier runs
EXTRACT_TIMEOUT_S=300                                            # one document's parse at any tier
ROUTE_MIN_CHARS_PER_PAGE=120                                     # below this a PDF counts as image-heavy -> docling+OCR
ROUTE_TABLE_LINE_THRESHOLD=6                                     # ruled-line objects per page suggesting a real table

# Limits
MAX_FILE_BYTES=10485760
MAX_TEXT_CHARS=500000
PORT=8006
