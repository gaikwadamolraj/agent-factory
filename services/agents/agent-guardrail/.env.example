# agent-guardrail - copy to .env for local runs (never commit .env). Secrets come from the k8s Secret in clusters.
APP_ENV=DEV
AUTH_ISSUER=http://auth-service                                  # tokens: auth-service ES256, verified with its JWKS
AUTH_JWKS_URL=http://localhost:8004/.well-known/jwks.json
AUTH_TOKEN_URL=http://localhost:8004/oauth/token
ALLOWED_CALLERS=ats-orchestrator,agent-knowledge-graph
TOOL_POLICY=ats-orchestrator=check_text,agent-knowledge-graph=check_text

# Classifier: open model now; switch to meta-llama/Llama-Prompt-Guard-2-86M once the Llama licence is accepted on
# the model page for the HF_TOKEN account (gated model).
CLASSIFIER_MODEL=protectai/deberta-v3-base-prompt-injection-v2
CLASSIFIER_THRESHOLD=0.5
HF_TOKEN=
MODEL_CACHE_DIR=./.models
