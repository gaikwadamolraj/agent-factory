# Knowledge service - copy to .env for local runs (never commit .env)
SERVICE_NAME=agent-knowledge-graph
APP_ENV=DEV
LOG_JSON=false
OTEL_ENABLED=false
GRAPHITI_TELEMETRY_ENABLED=false
DATABASE_URL=postgresql://USER:PASS@localhost:5432/ats_platform
# Redis 8 (or Redis Stack): vector search is needed for the semantic cache; use database 0
REDIS_URL=redis://:PASS@localhost:6379/1
REDIS_DB=0                      # the platform Redis; the semantic cache (vector search) needs database 0
AUTH_ISSUER=http://auth-service                                  # tokens: auth-service ES256, verified with its JWKS
AUTH_JWKS_URL=http://localhost:8004/.well-known/jwks.json
AUTH_TOKEN_URL=http://localhost:8004/oauth/token
SERVICE_CLIENT_SECRET=REPLACE-WITH-client-secret-of-this-service   # same value as CLIENT_SECRET_<SERVICE> of the auth-service

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=change-me


SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_DISTANCE=0.08
WORKER_CONCURRENCY=1

ALLOWED_CALLERS=ats-orchestrator
TOOL_POLICY=ats-orchestrator=ingest_episode|get_episode|search_knowledge|forget_source|update_entity|list_episodes|cancel_request

# LLM: only through the gateway (agent_common.llm); aliases + per-client policy defaults: deploy/helm/ats-platform/values.yaml (infra.llmConfig)
LLM_GATEWAY_URL=http://localhost:4000/v1
LLM_GATEWAY_KEY=sk-local-dev-gateway-key
