# NVIDIA NIM or any OpenAI-compatible endpoint
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-your-key-here
REASONING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NON_REASONING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Default demo SQLite database (auto-created on first run)
DEFAULT_DB_URL=sqlite:///./demo_enterprise.db
ONTOLOGY_STORE_PATH=./ontology_catalog.json
