# Agent - copy to .env for local runs (never commit .env)
SERVICE_NAME=agent-skill
APP_ENV=DEV
LOG_JSON=false
OTEL_ENABLED=false
DATABASE_URL=postgresql://USER:PASS@localhost:5432/ats_platform
REDIS_URL=redis://:PASS@localhost:6379/1
AUTH_ISSUER=http://auth-service                                  # tokens: auth-service ES256, verified with its JWKS
AUTH_JWKS_URL=http://localhost:8004/.well-known/jwks.json
AUTH_TOKEN_URL=http://localhost:8004/oauth/token
DEFAULT_SKILL_VERSION=v1

# Skill resolution. With REGISTRY_MCP_URL set, the version activated in the admin UI is what runs and the
# packaged module above is only the fallback; empty = packaged skills only (the default for local runs).
SKILL_DOMAIN=ats
REGISTRY_MCP_URL=
REGISTRY_TIMEOUT_S=10
# Needed only when REGISTRY_MCP_URL is set: this service's client_credentials secret, so it can get a service
# token for registry-service. k8s Secret key: client-secret-agent-skill.
SERVICE_CLIENT_SECRET=
ALLOWED_CALLERS=ats-orchestrator
TOOL_POLICY=ats-orchestrator=screen_candidate|ask_agent|cancel_request

# LLM: only through the gateway (agent_common.llm); aliases + per-client policy defaults: deploy/helm/ats-platform/values.yaml (infra.llmConfig)
LLM_GATEWAY_URL=http://localhost:4000/v1
LLM_GATEWAY_KEY=sk-local-dev-gateway-key
