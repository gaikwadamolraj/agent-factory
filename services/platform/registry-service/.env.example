# registry-service - copy to .env for local runs (never commit .env). Secrets come from the k8s Secret in clusters.
APP_ENV=DEV
SERVICE_NAME=registry-service
PORT=8005

# Data stores (shared with the rest of the platform)
DATABASE_URL=postgresql://ats:ats@localhost:5432/ats
REDIS_URL=redis://localhost:6379/0

# Auth: every token is signed by the auth-service (ES256) and verified here with its public keys (JWKS).
AUTH_ISSUER=http://auth-service
AUTH_JWKS_URL=http://localhost:8004/.well-known/jwks.json
AUTH_TOKEN_URL=http://localhost:8004/oauth/token

# This service's client_credentials secret (to get service tokens for the auth-service identity API + the tool
# catalogue). k8s Secret key: client-secret-registry-service. >= 32 chars. Leave empty for local REST-only runs.
SERVICE_CLIENT_SECRET=

# MCP front door (service callers/agents). Empty = no caller may drive registry-service over MCP yet (default deny).
ALLOWED_CALLERS=
TOOL_POLICY=

# Hardened REST wrapper
MAX_REQUEST_KB=256
CORS_ORIGINS=                      # comma-separated allow-list; "*" is used only outside PROD when empty
RATE_LIMIT_PER_MINUTE=120         # per-principal app-side rate limit (0 disables the hook)

# Delegated identity (registry-service -> auth-service)
AUTH_SERVICE_BASE_URL=http://auth-service
AUTH_SERVICE_AUDIENCE=auth-service

# Tool-catalogue proxy: registered MCP servers as "name=base_url|audience,other=base_url|audience"
MCP_REGISTRY=agent-skill=http://agent-skill|agent-skill,agent-knowledge-graph=http://agent-knowledge-graph|agent-knowledge-graph,agent-guardrail=http://agent-guardrail|agent-guardrail

# Telemetry
OTEL_ENABLED=false
