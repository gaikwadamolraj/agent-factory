# auth-service - copy to .env for local runs (never commit .env)
SERVICE_NAME=auth-service
APP_ENV=DEV
LOG_JSON=false
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DATABASE_URL=postgresql://USER:PASS@localhost:5432/ats_platform
REDIS_URL=redis://localhost:6379/1

# Issuer + public URLs (the same three values in every service)
AUTH_ISSUER=http://auth-service
AUTH_JWKS_URL=http://localhost:8004/.well-known/jwks.json
AUTH_TOKEN_URL=http://localhost:8004/oauth/token

# Signing key: PEM of an EC P-256 private key; one line with literal \n is fine here.
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | awk '{printf "%s\\n", $0}'
AUTH_SIGNING_KEY=REPLACE-WITH-PEM
# During a key rotation only: the previous key (its public key stays in the JWKS)
AUTH_SIGNING_KEY_PREVIOUS=

# Service clients: which caller may get tokens for which services, and each caller's secret (openssl rand -hex 32;
# the same value as SERVICE_CLIENT_SECRET of that caller)
OAUTH_CLIENT_AUDIENCES=ats-orchestrator=agent-skill|agent-compute|agent-knowledge-graph|agent-guardrail,agent-knowledge-graph=agent-guardrail,registry-service=auth-service
CLIENT_SECRET_ATS_ORCHESTRATOR=REPLACE-WITH-openssl-rand-hex-32
CLIENT_SECRET_AGENT_KNOWLEDGE_GRAPH=REPLACE-WITH-openssl-rand-hex-32
# registry-service calls the identity endpoints with a service token (aud auth-service); same value as registry-service's
# SERVICE_CLIENT_SECRET.
CLIENT_SECRET_REGISTRY_SERVICE=REPLACE-WITH-openssl-rand-hex-32

ACCESS_TOKEN_MINUTES=5
REFRESH_TOKEN_DAYS=1
SERVICE_TOKEN_MINUTES=5
COOKIE_SECURE=false          # plain http locally; true behind TLS
LOGIN_MAX_FAILURES=5
CLIENT_AUTH_MAX_FAILURES=5

# Delegated identity: which service callers may use /api/v1/identity (service token, aud auth-service).
IDENTITY_ALLOWED_CALLERS=registry-service

# Versioned password pepper (auth_service.passwords). 0 = no pepper (default; existing bcrypt hashes keep working).
# To enable: set the current version to N and provide secrets login_pepper_v1..login_pepper_vN (env LOGIN_PEPPER_V1=...).
# Rotate by raising the current version and adding the next secret; old hashes upgrade on the next correct login.
LOGIN_PEPPER_CURRENT_VERSION=0
# LOGIN_PEPPER_V1=REPLACE-WITH-openssl-rand-hex-32
# LOGIN_PEPPER_V2=REPLACE-WITH-openssl-rand-hex-32

# Signed invite tokens: HMAC key (secret), link TTL and the accept-invite page the link points at.
INVITE_SIGNING_KEY=REPLACE-WITH-openssl-rand-hex-32
INVITE_TTL_HOURS=72
INVITE_BASE_URL=http://localhost/registry-service/invite
