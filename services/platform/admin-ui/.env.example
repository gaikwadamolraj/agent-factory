# admin-ui - copy to .env.local for local runs (never commit real values). These are SERVER-side only: the browser
# never sees a backend URL or a token (every call goes through the Next.js proxy at <basePath>/api/backend).

# Base path the app is served under (must match the chart route; shares the host with /ats and /grafana).
NEXT_BASE_PATH=/admin

# Cluster-internal targets of the server-side proxy.
INTERNAL_REGISTRY_URL=http://localhost:8005   # registry-service: /api/v1/factory/*, /api/v1/mcp/*, /api/v1/notifications
INTERNAL_AUTH_URL=http://localhost:8004       # auth-service: /api/v1/auth/* (login, refresh, logout, me, invite)

# Upload / request size cap enforced by the proxy before reading the body (MB).
MAX_REQUEST_MB=5
