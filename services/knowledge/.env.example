# Knowledge service - copy to .env for local runs (never commit .env)
SERVICE_NAME=ats-knowledge
APP_ENV=DEV
LOG_JSON=false
OTEL_ENABLED=false
GRAPHITI_TELEMETRY_ENABLED=false
DATABASE_URL=postgresql://USER:PASS@localhost:5432/ats_platform
# Redis 8 (or Redis Stack): vector search is needed for the semantic cache; use database 0
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=change-me-at-least-32-characters-long-secret

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=change-me


SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_DISTANCE=0.08
WORKER_CONCURRENCY=1

ALLOWED_CALLERS=ats-orchestrator
TOOL_POLICY=ats-orchestrator=ingest_episode|get_episode|search_knowledge|forget_source|update_entity|list_episodes|cancel_request

# LLM: only through the gateway (ats_common.llm); aliases + per-client policy defaults are in deploy/k8s/base/llm-config
LLM_GATEWAY_URL=http://localhost:4000/v1
LLM_GATEWAY_KEY=sk-local-dev-gateway-key
