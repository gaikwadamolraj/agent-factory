# Orchestrator - copy to .env for local runs (never commit .env)
SERVICE_NAME=ats-orchestrator
APP_ENV=DEV
LOG_JSON=false
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DATABASE_URL=postgresql://USER:PASS@localhost:5432/ats_platform
REDIS_URL=redis://localhost:6379/1
JWT_SECRET=change-me-at-least-32-characters-long-secret
LLM_ENDPOINT=http://localhost:1235/v1
LLM_API_KEY=lm-studio
MODEL_NAME=meta-llama-3.1-8b-instruct
LLM_MAX_CONCURRENCY=5
AGENT_MCP_URL=http://localhost:8001/mcp
SKILL_VERSION=
