# Orchestrator - copy to .env for local runs (never commit .env)
SERVICE_NAME=ats-orchestrator
APP_ENV=DEV
LOG_JSON=false
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DATABASE_URL=postgresql://USER:PASS@localhost:5432/ats_platform
REDIS_URL=redis://:PASS@localhost:6379/1
AUTH_ISSUER=http://auth-service                                  # tokens: auth-service ES256, verified with its JWKS
AUTH_JWKS_URL=http://localhost:8004/.well-known/jwks.json
AUTH_TOKEN_URL=http://localhost:8004/oauth/token
SERVICE_CLIENT_SECRET=REPLACE-WITH-client-secret-of-this-service   # same value as CLIENT_SECRET_<SERVICE> of the auth-service
LLM_MAX_CONCURRENCY=5
AGENT_MCP_URL=http://localhost:8001/mcp
KNOWLEDGE_MCP_URL=http://localhost:8002/mcp     # empty = candidate knowledge graph off
KNOWLEDGE_INGEST_SCREENINGS=true
SKILL_VERSION=

# Domain pack: with REGISTRY_MCP_URL set, the client's activated pack supplies the knowledge guidance and
# ontology; empty = the packaged ones in knowledge/guidance.py. All-or-nothing: an incomplete pack falls back.
PACK_DOMAIN=ats
PACK_SKILL_NAME=ats_screening
REGISTRY_MCP_URL=
REGISTRY_TIMEOUT_S=10

# LLM: only through the gateway (agent_common.llm); aliases + per-client policy defaults: deploy/helm/ats-platform/values.yaml (infra.llmConfig)
LLM_GATEWAY_URL=http://localhost:4000/v1
LLM_GATEWAY_KEY=sk-local-dev-gateway-key

# Durable journeys (Temporal, docs/impl_temporal.md). Empty address = no engine: the API keeps its in-process
# path and the onboarding worker (python -m ats_orchestrator.worker) refuses to start rather than idling.
# A local engine: docker run -d -p 7233:7233 temporalio/temporal:latest server start-dev --ip 0.0.0.0
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
ONBOARDING_TASK_QUEUE=onboarding
ONBOARDING_TIMEOUT_S=3600
# Which queue `python -m ats_orchestrator.worker` polls. One image, one Deployment per queue, so each scales on
# its own backlog; locally it decides which journey this worker process picks up.
WORKER_QUEUE=onboarding
# J3 bulk match runs on a queue of its own: a thousand-candidate run lasting hours must not be able to delay one
# recruiter's upload, and a shared queue still shares workers whatever the priorities say.
BULK_MATCH_TASK_QUEUE=bulk-match
BULK_MATCH_TIMEOUT_S=21600                  # 6 hours: a full pool, one LLM call per subject, with retries
BULK_MATCH_PAGE_SIZE=50                     # subjects fetched per selection activity
BULK_MATCH_CONCURRENCY=8                    # subjects graded at once - the real throttle on LLM load
BULK_MATCH_MAX_SUBJECTS=1000                # hard ceiling on one run; raise deliberately, never per request
BULK_MATCH_TOP_N=50                         # how many results the run summary carries
# An upload starts a journey, so a slow engine must not hold the request open. Shared circuit breaker.
TEMPORAL_CONNECT_TIMEOUT_S=10
TEMPORAL_CALL_TIMEOUT_S=15
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=4        # the real throttle: activities embed and call the graph
TEMPORAL_MAX_CONCURRENT_WORKFLOW_TASKS=32
TEMPORAL_GRACEFUL_SHUTDOWN_S=30
